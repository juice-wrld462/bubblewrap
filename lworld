    <script>
        // Track which video is currently visible
        let currentVideoId = null;
        let videoProgress = {};
        let videoIntervals = {};
        let creatorEarnings = {
            'dancingqueen': 24.50,
            'travelguy': 18.30,
            'chefmike': 32.70
        };
        
        // Initialize all videos
        document.querySelectorAll('.video-container').forEach(container => {
            const videoId = container.getAttribute('data-video-id');
            const videoPlayer = container.querySelector('.video-player');
            const progressBar = container.querySelector('.progress');
            
            // Store initial progress
            videoProgress[videoId] = {
                progress: 0,
                isPlaying: false,
                watched: false
            };
            
            // Play video when it comes into view
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        // This video is now visible
                        currentVideoId = videoId;
                        videoPlayer.play();
                        videoProgress[videoId].isPlaying = true;
                        
                        // Start progress bar if not already started
                        if (!videoIntervals[videoId]) {
                            startVideoProgress(videoId, progressBar);
                        }
                        
                        // Track earnings for creator
                        const creator = container.getAttribute('data-creator');
                        if (!videoProgress[videoId].watched) {
                            videoProgress[videoId].watched = true;
                            updateCreatorEarnings(creator);
                        }
                    } else {
                        // Video is no longer visible
                        if (videoId === currentVideoId) {
                            currentVideoId = null;
                        }
                        videoPlayer.pause();
                        videoProgress[videoId].isPlaying = false;
                        
                        // Clear progress interval if video is not visible
                        if (videoIntervals[videoId]) {
                            clearInterval(videoIntervals[videoId]);
                            videoIntervals[videoId] = null;
                        }
                    }
                });
            }, {
                threshold: 0.8 // 80% of video must be visible
            });
            
            observer.observe(container);
            
            // Click to pause/play
            container.addEventListener('click', (e) => {
                // Don't toggle if clicking on interactive elements
                if (e.target.closest('.sidebar-item') || e.target.closest('.comment-section')) {
                    return;
                }
                
                if (videoProgress[videoId].isPlaying) {
                    videoPlayer.pause();
                    videoProgress[videoId].isPlaying = false;
                    
                    // Show video info
                    container.querySelector('.video-info').classList.remove('hidden');
                    
                    // Clear progress interval
                    if (videoIntervals[videoId]) {
                        clearInterval(videoIntervals[videoId]);
                        videoIntervals[videoId] = null;
                    }
                } else {
                    videoPlayer.play();
                    videoProgress[videoId].isPlaying = true;
                    
                    // Hide video info after delay
                    setTimeout(() => {
                        container.querySelector('.video-info').classList.add('hidden');
                    }, 2000);
                    
                    // Start progress interval if not already running
                    if (!videoIntervals[videoId]) {
                        startVideoProgress(videoId, progressBar);
                    }
                }
            });
        });
        
        // Start video progress tracking
        function startVideoProgress(videoId, progressBar) {
            videoIntervals[videoId] = setInterval(() => {
                videoProgress[videoId].progress += 1;
                progressBar.style.width = `${videoProgress[videoId].progress}%`;
                
                // Simulate earning coins for creator every 5 seconds
                if (videoProgress[videoId].progress % 5 === 0) {
                    const container = document.querySelector(`.video-container[data-video-id="${videoId}"]`);
                    const creator = container.getAttribute('data-creator');
                    
                    // Show coin animation
                    const coinAnim = container.querySelector('.coin-animation');
                    coinAnim.classList.remove('hidden');
                    coinAnim.textContent = `+${0.01}`;
                    coinAnim.classList.add('coin-animation');
                    
                    setTimeout(() => {
                        coinAnim.classList.remove('coin-animation');
                        coinAnim.classList.add('hidden');
                    }, 1000);
                    
                    // Update creator earnings
                    creatorEarnings[creator] += 0.01;
                    creatorEarnings[creator] = parseFloat(creatorEarnings[creator].toFixed(2));
                    
                    // Show earnings notification occasionally
                    if (Math.random() > 0.7) {
                        showEarningsNotification(creator);
                    }
                }
                
                if (videoProgress[videoId].progress >= 100) {
                    clearInterval(videoIntervals[videoId]);
                    videoIntervals[videoId] = null;
                    videoProgress[videoId].progress = 0;
                    progressBar.style.width = '0%';
                    
                    // In a real app, this would load the next video
                    // For demo, just restart the progress
                    setTimeout(() => {
                        startVideoProgress(videoId, progressBar);
                    }, 1000);
                }
            }, 300);
        }
        
        // Update creator earnings
        function updateCreatorEarnings(creator) {
            // In a real app, this would send to backend
            console.log(`Creator ${creator} earned from a new view`);
            
            // Show notification
            showEarningsNotification(creator);
        }
        
        // Show earnings notification
        function showEarningsNotification(creator) {
            const notification = document.getElementById('earnings-notification');
            const earningsText = notification.querySelector('p');
            
            earningsText.innerHTML = `You've earned <span class="text-yellow-400 font-medium">$${creatorEarnings[creator].toFixed(2)}</span> from your latest video!`;
            
            notification.classList.remove('hidden');
            setTimeout(() => {
                notification.classList.add('hidden');
            }, 3000);
        }
        
        // Like button functionality
        document.querySelectorAll('.like-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const videoId = btn.getAttribute('data-video-id');
                const heartIcon = btn.querySelector('.heart-icon');
                const likeCount = btn.querySelector('.like-count');
                
                if (heartIcon.classList.contains('far')) {
                    // Like the video
                    heartIcon.classList.remove('far');
                    heartIcon.classList.add('fas', 'text-pink-500', 'heart-animation');
                    
                    // Update like count
                    let currentLikes = parseInt(likeCount.textContent.replace('K', '') * 1000);
                    currentLikes += 1;
                    likeCount.textContent = currentLikes >= 1000 ? (currentLikes/1000).toFixed(1) + 'K' : currentLikes;
                    
                    // In a real app, this would send to backend
                    console.log(`Liked video ${videoId}`);
                } else {
                    // Unlike the video
                    heartIcon.classList.remove('fas', 'text-pink-500');
                    heartIcon.classList.add('far');
                    
                    // Update like count
                    let currentLikes = parseInt(likeCount.textContent.replace('K', '') * 1000);
                    currentLikes -= 1;
                    likeCount.textContent = currentLikes >= 1000 ? (currentLikes/1000).toFixed(1) + 'K' : currentLikes;
                    
                    // In a real app, this would send to backend
                    console.log(`Unliked video ${videoId}`);
                }
            });
        });
        
        // Comment button functionality
        document.querySelectorAll('.comment-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const container = btn.closest('.video-container');
                const commentSection = container.querySelector('.comment-section');
                
                // Toggle comment section
                commentSection.classList.toggle('active');
                
                // Pause video when comments are open
                const videoPlayer = container.querySelector('.video-player');
                videoPlayer.pause();
                videoProgress[container.getAttribute('data-video-id')].isPlaying = false;
                
                // Clear progress interval
                const videoId = container.getAttribute('data-video-id');
                if (videoIntervals[videoId]) {
                    clearInterval(videoIntervals[videoId]);
                    videoIntervals[videoId] = null;
                }
            });
        });
        
        // Close comments buttons
        document.querySelectorAll('.close-comments').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const commentSection = btn.closest('.comment-section');
                commentSection.classList.remove('active');
                
                // Resume video if it was playing
                const container = commentSection.closest('.video-container');
                const videoId = container.getAttribute('data-video-id');
                
                if (currentVideoId === videoId) {
                    const videoPlayer = container.querySelector('.video-player');
                    videoPlayer.play();
                    videoProgress[videoId].isPlaying = true;
                    
                    // Start progress interval if not already running
                    if (!videoIntervals[videoId]) {
                        const progressBar = container.querySelector('.progress');
                        startVideoProgress(videoId, progressBar);
                    }
                }
            });
        });
        
        // Simulate initial video play
        document.addEventListener('DOMContentLoaded', () => {
            const firstVideo = document.querySelector('.video-container');
            const firstVideoPlayer = firstVideo.querySelector('.video-player');
            const firstProgressBar = firstVideo.querySelector('.progress');
            const firstVideoId = firstVideo.getAttribute('data-video-id');
            
            firstVideoPlayer.play();
            videoProgress[firstVideoId].isPlaying = true;
            startVideoProgress(firstVideoId, firstProgressBar);
            
            // Hide video info after delay
            setTimeout(() => {
                firstVideo.querySelector('.video-info').classList.add('hidden');
            }, 3000);
        });
    </script>
</body>
</html>
